---
version: "2.0"
services:
  dapp:
    image: discoverdefiteam/dao-modules-sda:v0.0.10
    expose:
      - port: 3000
        as: 80
        accept:
          - infuse.permissionless.money
          - www.infuse.permissionless.money
        to:
          - global: true
profiles:
  compute:
    dapp:
      resources:
        cpu:
          units: 4
        memory:
          size: 16GB
        storage:
          - size: 120GB
  placement:
    dcloud:
      pricing:
        dapp:
          denom: uakt
          amount: 10000
        sda:
          denom: uakt
          amount: 10000
deployment:
  dapp:
    dcloud:
      profile: dapp
      count: 1